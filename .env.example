REACTOR_SMTP_USER=
REACTOR_SMTP_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/social/google/callback
# Solo desarrollo o demo: con 1, la API devuelve los codigos de verificacion y
# recuperacion en la respuesta HTTP. El servidor no envia correos; fuera de una
# demo dejalo en 0 (valor por defecto).
EXPOSE_CODES=0
